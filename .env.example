# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/kca_helpdesk?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars-change-in-production"

# Email (Nodemailer - configure for your SMTP provider)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"
EMAIL_FROM="KCA ICT Helpdesk <helpdesk@kcau.ac.ke>"

# File Uploads (local storage for v1, can be S3 later)
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE="5242880" # 5MB

# App Settings
NEXT_PUBLIC_APP_NAME="KCA ICT Helpdesk"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTO_CLOSE_DAYS="7"